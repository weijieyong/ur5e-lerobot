# Copy to config/local/machine.env (git-ignored) and edit. Loaded by every `pixi run` / `pixi shell`.
# Camera colour settings, floor height and training sizes below are placeholders, not calibrated values.

# --- paths and task (both machines) ----------------------------------------------------------
# HF_HOME controls the download/auth cache; training always reads <project>/hf/hub.
HF_HOME="$PIXI_PROJECT_ROOT/hf"
HF_LEROBOT_HOME="$PIXI_PROJECT_ROOT/data"
DATASET_REPO_ID=local/ur5e_pick_tray
TASK="pick up the object and place it on the tray"
CONTROL_FPS=15                    # robot control, recording and rollouts must use the same rate
TIMING_LOG_DIR="$PIXI_PROJECT_ROOT/outputs/timing"  # unique host-clock JSONL per robot session; empty disables

# --- robot and SpaceMouse (robot PC) ---------------------------------------------------------
UR5E_IP=  # REQUIRED: controller address
UR5E_HOME_JOINTS_DEG=""  # REQUIRED: measured degrees, base -> wrist 3; no universal safe pose
UR5E_Z_MIN_M=0.10                 # PLACEHOLDER: minimum TCP z in base frame (m); measure before motion
UR5E_FLOOR_MARGIN_M=0.01          # added by `pixi run set-floor` to the measured TCP z
# Optional base-frame TCP side bounds (metres). Empty = unbounded; no ceiling.
# `pixi run set-boundaries` captures all five faces, including UR5E_Z_MIN_M above.
UR5E_X_MIN_M=
UR5E_X_MAX_M=
UR5E_Y_MIN_M=
UR5E_Y_MAX_M=
UR5E_WORKSPACE_MARGIN_M=0.01      # inward clearance on all five captured faces; applied once when saving
BOUNDARY_LINEAR_SPEED_M_S=0.03    # teaching caps, further limited by the normal SpaceMouse speeds
BOUNDARY_ANGULAR_SPEED_RAD_S=0.15
SPACEMOUSE_AXES=xyz_yaw            # xyz_yaw (default); bounded only after you run pixi run set-neutral; full: unrestricted rotation
SPACEMOUSE_NEUTRAL_ROTVEC=         # pixi run set-neutral: three UR rotation-vector radians, not Euler angles
SPACEMOUSE_TILT_LIMIT_DEG=10       # +/- roll and pitch relative to neutral; yaw about base Z stays free
SPACEMOUSE_OPERATOR_YAW_DEG=0
SPACEMOUSE_LINEAR_SPEED_M_S=0.10
SPACEMOUSE_ANGULAR_SPEED_RAD_S=0.5
SPACEMOUSE_CLOSE_BUTTON=0          # left button on a SpaceMouse Compact
SPACEMOUSE_OPEN_BUTTON=1           # right
# raw HID channel -> (vx vy vz wx wy wz); default suits a SpaceMouse Compact
SPACEMOUSE_AXIS_MAP="+0 -1 -2 +3 -4 -5"
GRIPPER_TYPE=robotiq               # robotiq (2F-85), onrobot_rg2 (RG2), or none (six arm joints only)
GRIPPER_CLOSE_WIDTH_MM=8           # onrobot_rg2 only: "closed" finger width; 0 mm on nothing latches its safety switch
GRIPPER_FORCE=                     # 0-255 for teleop, recording and rollout; empty: 64 robotiq, 128 (~20 N) onrobot_rg2 (0-40 N)

# --- cameras (robot PC) ----------------------------------------------------------------------
# Find serials with: pixi run lerobot-find-cameras realsense
FRONT_CAMERA_SERIAL=  # REQUIRED: measured device identity   # D455 or D435i, external
WRIST_CAMERA_SERIAL=  # REQUIRED: measured device identity   # D405, wrist
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
CAMERA_MAX_AGE_MS=100              # reject stale buffered images (host arrival age, not exposure age)
# PLACEHOLDERS: replace with settings locked for your scene. Values use the camera's native units.
# Empty values leave that option unchanged; setting exposure/gain disables auto exposure.
FRONT_CAMERA_EXPOSURE=150
FRONT_CAMERA_GAIN=64
FRONT_CAMERA_WHITE_BALANCE=4500
WRIST_CAMERA_EXPOSURE=5000
WRIST_CAMERA_GAIN=16
WRIST_CAMERA_WHITE_BALANCE=4500

# --- demonstration recording (robot PC) ------------------------------------------------------
RECORD_EPISODES=50
# Recording uses keyboard Right arrow/n start/stop; READY has no timer, including in rollout.

# Training takes explicit dataset root/repo ID; recipe owns chunk/split/schedule.
# See docs/training.md. Train-only statistics fit automatically at startup.

# --- supervised rollouts (robot PC) ----------------------------------------------------------
ROLLOUT_POLICY_PATH=""  # set explicitly to the selected checkpoint's pretrained_model directory
ROLLOUT_DATASET_REPO_ID=local/rollout_ur5e_pick_tray  # name must start with rollout_
ROLLOUT_EPISODES=10
ROLLOUT_EPISODE_TIME_S=30          # policy seconds after Right/START; excludes model load and READY
RTC_EXECUTION_HORIZON=10
# Rollout-only controls. Keep CONTROL_FPS at the training/collection rate (15).
ROLLOUT_MAX_JOINT_STEP_RAD=0.01    # target distance from measured joints; not a measured velocity guarantee
ROLLOUT_GRIPPER_SPEED=128         # 0-255, independent of arm target limit; Robotiq only
ROLLOUT_HOME_SPEED_RAD_S=0.1      # explicit h move while READY only
ROLLOUT_DENOISE_STEPS=10          # diffusion compute/quality tradeoff, not physical playback speed

# Robot PC runs offline; the tokenizer is copied with the checkpoint.
# Set 0 on the training host only for the first model download (docs/training.md#model-downloads).
HF_HUB_OFFLINE=1
